---
import { profile } from '../data/profile';
import '../styles/global.css';

const faviconPath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} | Mathematics and computation</title>
    <meta name="description" content="Kevin Vélez Escarria, mathematician. Fourier analysis, inverse problems, scientific computing and a background in electronics and backend development." />
    <meta name="theme-color" content="#F8FAFC" />
    <link rel="icon" type="image/svg+xml" href={faviconPath} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
