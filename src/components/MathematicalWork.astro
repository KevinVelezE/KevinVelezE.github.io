---
import { selectedWorks } from '../data/profile';
---
<section class="work-section wrapper" id="mathematical-work" aria-labelledby="work-heading">
  <div class="section-intro">
    <h2 id="work-heading">Mathematical work</h2>
    <p>Analysis, reconstruction and numerical experimentation.</p>
  </div>
  {selectedWorks.map((work) => (
    <article class="work-entry">
      <div class="work-meta">
        <p class="work-kind">{work.kind}</p>
        <p>{work.kind === 'Undergraduate thesis' ? 'Universidad del Valle' : 'MAPI 4 · 2026'}</p>
      </div>
      <div class="work-body">
        <h3>{work.title}</h3>
        <p class="work-authors">{work.authors.join(' and ')}</p>
        <p>{work.description}</p>
        {work.pdfUrl && <a class="document-link" href={work.pdfUrl}>
          {work.kind === 'Undergraduate thesis' ? 'Read thesis' : 'Read abstract'}
          <span class="link-detail"> (PDF)</span>
        </a>}
      </div>
    </article>
  ))}
</section>
